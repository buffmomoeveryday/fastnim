+
+proc upgradeStream*(req: HttpRequestRef): AsyncStream =
+  ## Returns the request's raw stream for a protocol upgrade.
+  ##
+  ## The caller owns the HTTP response from this point onward and must write
+  ## the upgrade handshake to the returned stream.
+  let response = req.getResponse()
+  response.flags.excl(HttpResponseFlags.KeepAlive)
+  response.state = HttpResponseState.Finished
+  AsyncStream(reader: req.connection.reader, writer: req.connection.writer)
 
